<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Live support view: video-only screen capture, consent asked per session. No audio. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Private sideloaded deployment: inventory is sent only to the configured LAN server. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Private managed deployment; grant once per headset with adb appops. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!-- Managed Quest fleet: ADB grants this app-op so an admin cast request can
         surface the system consent activity while a customer app is in front. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:label="CafeQuest"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".CastConsentActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name=".AgentService"
            android:foregroundServiceType="dataSync|mediaProjection"
            android:exported="false" />
    </application>
</manifest>
