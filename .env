# Copy to .env (never commit .env); the server loads it automatically.
# Unset keys = open LAN POC mode with a boot warning.
ADMIN_API_KEY=gladsos-admin123
DEVICE_ENROLLMENT_KEY=gladsos-device123
PORT=3000
HOST=0.0.0.0
# Optional overrides:
# DB_PATH=/absolute/path/to/cafequest.db
# CAFEQUEST_CONFIG=/absolute/path/to/cafequest.config.json

# LAN address headsets dial; baked into the APK as the setup-screen default.
CAFE_PC_LAN_HOST=192.168.1.150
